# Build-time settings for the web game. Copy to .env and fill in:
#   cp .env.example .env
# Values: Firebase console > Project settings > Your apps > Web app (SDK setup).
# .env is git-ignored. CI writes it from the APP_ENV repository secret.
# Without the three required values the game still builds and plays offline;
# sign-in, shared worlds and leaderboards are then unavailable.

# Required
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Optional (defaults shown in comments)
# <project>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
# Google Analytics; nothing is sent while empty
FIREBASE_MEASUREMENT_ID=
# Web push key (Cloud Messaging > Web Push certificates); web reminders are off while empty
FIREBASE_VAPID_KEY=
# App Check: the reCAPTCHA Enterprise site key (App Check > Apps > web app); off while empty
FIREBASE_APPCHECK_SITE_KEY=
# Local only: an App Check debug token (App Check > Apps > Manage debug tokens) so
# localhost passes App Check. Dropped from production builds; never put it in APP_ENV.
FIREBASE_APPCHECK_DEBUG_TOKEN=

# Build switches (not secrets)
# REQUIRE_FIREBASE_ENV=1 fails the build when a required value is missing (deploys)
