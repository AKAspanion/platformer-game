rules_version = '2';

// Dino's Adventure.
//
// worlds/{id}: every world anyone has shared. Anyone can read them (the
// community list is public, sign-in is only needed to create). Nobody writes
// them from a client: the publishWorld function validates each world with the
// game's sanitizeWorld and stamps the author from the caller's ID token.
//
// daily/{seed}/scores/{uid}: one best score per player per day. Nobody writes
// it from a client: the submitDailyScore function checks the run (open day,
// possible score, plausible time) and writes it. No client reads or lists it,
// the owner included: Firestore hands every reader a document's create and
// update times, which would show when each improving run happened. Boards ask
// the getDailyBoard function, which returns the top 50 and the caller's own
// entry, each only uid, name, score and seconds (functions/src/boards.js).
//
// endless/{uid}: one best endless run per player (highest level, then score,
// then the shorter time). Written only by the submitEndlessScore function and,
// like the daily board, never read by a client: the getEndlessBoard function
// returns uid, name, level, score and seconds.
//
// saves/{uid}: one cloud save per account. Only that account reads or writes
// it, and a write carries exactly v, updatedAt and data.
//
// worldStats/{worldId} (+ days/{day}, seen/{uid_day_kind}): play, finish and
// like counts, written by the functions only. Anyone reads the counts and the
// daily buckets; the dedupe markers in seen/ are closed.
//
// worldLikes/{worldId}_{uid}: one doc per like; an account reads only its own.
//
// thumbs/{worldId}: world thumbnails, closed (worldPage serves them).
//
// config/featured: the world of the week, anyone reads, functions write.
//
// pushSubs/{uid}: an account's reminder devices and time zone, functions only.
//
// limits/{uid}: per-user rate limit counters, functions only.
//
// runs/{ticket}: ranked run tickets (startRun), functions only.
//
// players/{uid}: a player's looks and, optionally, the UTC day they were last
// online, shown on the boards. No client reads them: the getProfiles function
// hands out the four fields, 30 players at a time, without the document's
// create and update times. Only that account writes its own, anonymous accounts included, and a write
// carries exactly skin, hat and companion, each an item ID the shop has (the
// lists match app/shop/catalog.js, checked by tests/profiles-rules-file.test.js),
// and optionally seenDay: an int, yesterday's, today's or tomorrow's UTC day
// number by the server's clock. Never a name or a time. Nobody deletes it from a client: the
// deleteAccount function does.
service cloud.firestore {
  match /databases/{database}/documents {
    match /worlds/{worldId} {
      allow get: if true;
      allow list: if request.query.limit <= 100;
      allow write: if false;
    }

    // no client get or list: boards come from getDailyBoard / getEndlessBoard
    match /daily/{seed}/scores/{uid} {
      allow read: if false;
      allow write: if false;
    }

    match /endless/{uid} {
      allow read: if false;
      allow write: if false;
    }

    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'updatedAt', 'data'])
        && request.resource.data.keys().hasAll(['v', 'updatedAt', 'data'])
        && request.resource.data.v is number
        && request.resource.data.updatedAt is number
        && request.resource.data.data is map;
      allow delete: if false;
    }

    match /worldStats/{worldId} {
      allow get: if true;
      allow list: if request.query.limit <= 100;
      allow write: if false;

      match /days/{day} {
        allow get: if true;
        allow list: if request.query.limit <= 100;
        allow write: if false;
      }

      // seen/{uid_day_kind}: dedupe markers, functions only (no match: denied).
    }

    match /worldLikes/{id} {
      // decided from the id (<worldId>_<uid>), so a like that does not exist reads as "not liked"
      allow get: if request.auth != null && id.matches('.*_' + request.auth.uid);
      allow write: if false;
    }

    // thumbs/{worldId}: base64 PNGs served by worldPage, functions only.
    match /thumbs/{worldId} {
      allow write: if false;
    }

    // pushSubs/{uid}: device tokens, written and read by the functions only.
    match /pushSubs/{uid} {
      allow read, write: if false;
    }

    // runs/{ticket}: run tickets, written and read by the functions only.
    match /runs/{ticket} {
      allow read, write: if false;
    }

    match /config/{doc} {
      allow get: if true;
      allow write: if false;
    }

    match /players/{uid} {
      // today's UTC day number by the server's clock, yesterday's or tomorrow's:
      // a device clock a day off either way still counts
      function isSeenDay(day) {
        let today = int(request.time.toMillis() / 86400000);
        return day is int && day >= today - 1 && day <= today + 1;
      }

      // No client reads or lists profiles, the owner included: Firestore hands
      // every reader a document's create and update times, which would show the
      // time of day a player played. Boards ask the getProfiles function, which
      // returns only the four fields (functions/src/profiles.js).
      allow read: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['skin', 'hat', 'companion', 'seenDay'])
        && request.resource.data.keys().hasAll(['skin', 'hat', 'companion'])
        && request.resource.data.skin in ['classic', 'mint', 'sunset', 'midnight', 'ghost', 'gold', 'ocean', 'lava', 'candy']
        && request.resource.data.hat in ['none', 'cap', 'party', 'viking', 'wizard', 'crown', 'cowboy', 'tophat', 'pirate']
        && request.resource.data.companion in ['none', 'hatchling', 'ptero', 'trike', 'stego', 'raptor', 'ankylo', 'golden', 'crystal']
        && (!('seenDay' in request.resource.data) || isSeenDay(request.resource.data.seenDay));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
