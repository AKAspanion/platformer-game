{
  "name": "platformer-game",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack serve",
    "dep": "gh-pages -d dist",
    "deploy": "gh-pages -d dist",
    "predeploy": "pnpm install && pnpm build",
    "serve": "webpack-dashboard -m -c green -t react -- webpack serve",
    "format": "prettier --write .",
    "levels": "node scripts/generate-levels.js && prettier --write app/areas && python3 scripts/generate-thumbnails.py",
    "sprites": "python3 scripts/generate-sprites.py && python3 scripts/generate-enemy-death.py && python3 scripts/generate-icons.py",
    "audio": "python3 scripts/generate-audio.py",
    "test": "node scripts/test.js",
    "lint": "eslint .",
    "functions:sync": "node scripts/sync-functions-shared.js",
    "emulators": "node scripts/sync-functions-shared.js && firebase emulators:start",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dino \"node scripts/test-rules.js\""
  },
  "author": "Ankit Kumar Pandit",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "game",
    "2d-game",
    "platformer",
    "platformer-game"
  ],
  "description": "🎮 A 2D platformer game.",
  "bugs": {
    "url": "https://github.com/AKAspanion/platformer-game/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKAspanion/platformer-game.git"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "esbuild": "^0.28.2",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.14.0",
    "eslint-webpack-plugin": "^6.0.0",
    "firebase-tools": "^15.35.0",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.10",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dashboard": "^3.3.8",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "firebase": "^13.2.0"
  }
}
