{
  "name": "platformer-game",
  "version": "0.0.1",
  "main": "index.js",
  "scripts": {
    "build": "webpack",
    "dev": "webpack serve",
    "dep": "gh-pages -d dist",
    "deploy": "gh-pages -d dist",
    "predeploy": "yarn && yarn build",
    "serve": "webpack-dashboard -m -c green -t react -- webpack serve",
    "format": "prettier --write .",
    "levels": "node scripts/generate-levels.js && prettier --write app/areas",
    "sprites": "python3 scripts/generate-enemy-death.py",
    "test": "node scripts/test.js"
  },
  "author": "Ankit Kumar Pandit",
  "license": "MIT",
  "keywords": [
    "game",
    "2d-game",
    "platformer",
    "platformer-game"
  ],
  "description": "🎮 A 2D platformer game.",
  "bugs": {
    "url": "https://github.com/AKAspanion/platformer-game/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKAspanion/platformer-game.git"
  },
  "devDependencies": {
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.14.0",
    "eslint-webpack-plugin": "^6.0.0",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.10",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dashboard": "^3.3.8",
    "webpack-dev-server": "^6.1.0"
  }
}
