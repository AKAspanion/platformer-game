<?xml version="1.0" encoding="utf-8"?>
<!--
    Not generated by Bubblewrap: re-apply after `bubblewrap update` (see packages/android/README.md).
    As values/launcher_theme.xml, plus Android 12+'s starting window: it would show the launcher
    icon (the adaptive icon, a zoomed-in crop of the dino) before the app's own full-dino splash.
    A blank icon on the splash colour leaves the app's splash as the only image.
-->
<resources>
    <style name="LauncherTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:statusBarColor">@color/backgroundColor</item>
        <item name="android:navigationBarColor">@color/backgroundColor</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowSplashScreenBackground">@color/backgroundColor</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank_icon</item>
    </style>
</resources>
