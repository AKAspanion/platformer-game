<?xml version="1.0" encoding="utf-8"?>
<!--
    Not generated by Bubblewrap: re-apply after `bubblewrap update` (see packages/android/README.md).

    The launcher's window is opaque, in the splash colour, and full-screen. Bubblewrap's default
    is translucent, but Android ignores a translucent activity's orientation while it hands off to
    Chrome, so the home screen (portrait) briefly decides the rotation: the display turns to
    portrait and back, flashing the home screen on a cold launch. Opaque, the launcher keeps the
    display in landscape (android:screenOrientation in AndroidManifest.xml) until Chrome takes over.
-->
<resources>
    <style name="LauncherTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:statusBarColor">@color/backgroundColor</item>
        <item name="android:navigationBarColor">@color/backgroundColor</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
