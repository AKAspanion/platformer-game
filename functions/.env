# Non-secret settings for the functions, read at deploy (Firebase params).
# Secrets (ANTHROPIC_API_KEY) live in Secret Manager, never here.

# App Check on the callables: false = monitor (calls without a valid token are
# logged as "call without App Check"), true = refused. Turn on once the logs show
# the live game sends tokens. See functions/README.md.
APP_CHECK_ENFORCE=false
